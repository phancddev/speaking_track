# Caddy terminates HTTPS for the web app and the MinIO public endpoint.
#
# Local development: WEB_DOMAIN and S3_PUBLIC_DOMAIN default to localhost and
# s3.localhost. Caddy issues certificates for these from its internal CA
# (root cert available at /data/caddy/pki/authorities/local/root.crt inside
# the caddy_data volume; import it into the host/browser trust store for
# non-curl clients).
#
# Production: hostnames are substituted through environment variables ONLY —
# set WEB_DOMAIN and S3_PUBLIC_DOMAIN in .env (for example
# WEB_DOMAIN=app.example.com, S3_PUBLIC_DOMAIN=s3.example.com). Caddy then
# obtains public ACME certificates automatically. Never edit this file per
# environment.

{
	# Browsers omit SNI for IP-literal addresses; without a default the TLS
	# handshake has no certificate to offer and fails with an internal error.
	default_sni {$WEB_DOMAIN:localhost}
}

https://{$WEB_DOMAIN:localhost} {
	# One-shot download of Caddy's local root CA so LAN clients can trust
	handle /lan-root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		# Baseline security headers.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Camera/microphone are required by this application itself only.
		Permissions-Policy "camera=(self), microphone=(self)"
		-Server
	}
}

# Plain-HTTP mirror of the web app for LAN deployments that accept
# unencrypted browsing (APP_EXTRA_ORIGINS + AUTH_INSECURE_COOKIES in .env).
# Defining the http:// site explicitly also disables the automatic
# HTTP->HTTPS redirect. Camera capture still requires HTTPS; uploads and
# playback presign for the HTTPS S3 endpoint, so those stay on HTTPS.
http://{$WEB_DOMAIN:localhost} {
	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self)"
		-Server
	}
}

https://{$S3_PUBLIC_DOMAIN:s3.localhost} {
	# Browser-reachable endpoint for presigned S3 operations. The original
	# Host header is preserved so signatures stay valid; presigned URLs must
	# always be signed for this public hostname, never for the internal
	# minio:9000 endpoint.
	reverse_proxy minio:9000

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}
}
