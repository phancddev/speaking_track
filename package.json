{
  "name": "speaking-track",
  "version": "0.1.0",
  "private": true,
  "description": "Speaking Track — private speaking-practice workspace (monorepo root)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @speaking-track/web dev",
    "dev:worker": "pnpm --filter @speaking-track/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "pnpm --filter @speaking-track/db run db:generate",
    "db:migrate": "pnpm --filter @speaking-track/db run db:migrate",
    "db:reset": "pnpm --filter @speaking-track/db run db:reset",
    "bootstrap:admin": "pnpm --filter @speaking-track/web run bootstrap:admin"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
