# Speaking Track — environment variable reference.
#
# Copy this file to .env and fill in real values. .env is gitignored;
# NEVER commit real credentials. This file carries names and safe
# descriptions only.

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------

# Canonical origin of the web application as reachable from the browser.
# Local development: https://localhost
APP_ORIGIN=

# production | development | test. Containers run production.
NODE_ENV=

# --------------------------------------------------------------------------
# Database and queue
# --------------------------------------------------------------------------

# PostgreSQL connection string for HOST-SIDE tooling (pnpm db:migrate,
# db:reset, bootstrap commands): compose binds postgres to 127.0.0.1:5432.
# Local shape: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/<POSTGRES_DB>
# The compose web/worker containers derive their own in-network URL from
# POSTGRES_* below, so this value never needs the `postgres` hostname.
DATABASE_URL=

# Redis connection string used by web and worker (inside the compose network
# the host is `redis`).
REDIS_URL=

# PostgreSQL container credentials (compose interpolation).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --------------------------------------------------------------------------
# Better Auth (used from task 03)
# --------------------------------------------------------------------------

# Secret used to hash/session-sign auth tokens. Generate with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional LAN dual-protocol mode: also trust this plain-HTTP origin and issue
# non-Secure session cookies so the app works over http:// without a trusted
# CA. Camera capture still requires HTTPS. Leave both empty for HTTPS-only.
APP_EXTRA_ORIGINS=
AUTH_INSECURE_COOKIES=

# URL Better Auth considers canonical; matches APP_ORIGIN in this deployment.
BETTER_AUTH_URL=

# Credentials for the one-time admin bootstrap command (pnpm bootstrap:admin).
# Supply values only when running the bootstrap; they are never defaulted.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# --------------------------------------------------------------------------
# S3-compatible storage (MinIO locally)
# --------------------------------------------------------------------------

# Endpoint used by SERVER-SIDE code (web/worker containers). Internal compose
# value: http://minio:9000
S3_INTERNAL_ENDPOINT=

# Endpoint used for PRESIGNED URLs handed to the BROWSER, served through
# Caddy. Local value: https://s3.localhost — production: your public storage
# hostname. IMPORTANT: presigned URLs must be signed for a browser-reachable
# hostname; never sign URLs for minio:9000 (the signature host would be
# wrong and unreachable for clients).
S3_PUBLIC_ENDPOINT=

S3_REGION=
S3_BUCKET=

# MinIO root credentials (compose interpolation). These become the S3 access
# keys for both server-side and presigned operations. No defaults exist.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Path-style addressing (true for MinIO; typically false for virtual-host
# style providers such as AWS S3).
S3_FORCE_PATH_STYLE=

PRESIGNED_UPLOAD_TTL_SECONDS=
# Lifetime of presigned GET playback URLs handed to the browser (default 3600).
PRESIGNED_PLAYBACK_TTL_SECONDS=
MAX_RECORDING_BYTES=
TEMP_UPLOAD_RETENTION_HOURS=
MAX_STAGING_BYTES=

# --------------------------------------------------------------------------
# YouTube OAuth (used from task 06)
# --------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Key for AES-256-GCM envelope encryption of stored OAuth/refresh tokens.
# Generate with: openssl rand -base64 32
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Product contract constrains this to `unlisted`.
YOUTUBE_PRIVACY_STATUS=
YOUTUBE_CATEGORY_ID=
YOUTUBE_NOTIFY_SUBSCRIBERS=
YOUTUBE_UPLOAD_CONCURRENCY=
# How often the deferred-upload scanner re-checks QUEUED recordings (seconds,
# default 300). Quota-blocked uploads retry automatically after the daily
# quota reset (midnight Pacific Time).
YOUTUBE_SCAN_INTERVAL_SECONDS=

# --------------------------------------------------------------------------
# Caddy (HTTPS proxy)
# --------------------------------------------------------------------------

# Public hostname Caddy serves the web app on. Substituted into the Caddyfile
# through environment ONLY — never edit Caddyfile per environment.
# Local development default: localhost (internal CA certificate).
WEB_DOMAIN=

# Public hostname Caddy serves the MinIO/S3 endpoint on (presigned URL host).
# Local development default: s3.localhost (internal CA certificate).
S3_PUBLIC_DOMAIN=

# Optional host port overrides for the Caddy container. Defaults are the
# production ports 80/443; override only on machines where those are taken
# (for example a local DNS resolver bound to :80).
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=
